rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---------- Global default: deny everything ----------
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ---------- Helpers ----------
    // Staff-level access requires a verified email address (mirrors Firestore rules).
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function getRole() {
      return request.auth != null && request.auth.token.role != null ? request.auth.token.role : 'Member';
    }

    function isStaff() {
      return isVerified() && getRole() in ['SuperAdmin', 'Admin', 'Pastor', 'Minister', 'DepartmentLeader'];
    }

    function isAdmin() {
      return isVerified() && (getRole() == 'SuperAdmin' || getRole() == 'Admin');
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isDoc() {
      return request.resource.contentType.matches('application/pdf')
        || request.resource.contentType.matches('text/.*')
        || request.resource.contentType.matches('application/msword')
        || request.resource.contentType.matches('application/vnd\\.openxmlformats.*');
    }

    function underLimit(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ---------- Profile avatars: owner-only upload, public read ----------
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && isImage()
        && underLimit(5);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ---------- Members folder: staff-only write, staff read ----------
    match /members/{memberId}/{fileName} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && (isImage() || isDoc())
        && underLimit(10);
      allow delete: if isStaff();
    }

    // ---------- Sermons: public read, staff write (large media allowed) ----------
    match /sermons/{fileName} {
      allow read: if true;
      allow create, update: if isStaff()
        && (isVideo() || isAudio() || isImage() || isDoc())
        && underLimit(500);
      allow delete: if isStaff();
    }

    // ---------- Public content folder: public read, staff write ----------
    match /public/{folder}/{fileName} {
      allow read: if true;
      allow create, update: if isStaff()
        && isImage()
        && underLimit(15);
      allow delete: if isStaff();
    }
  }
}
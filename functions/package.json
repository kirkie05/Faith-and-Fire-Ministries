{
  "name": "faith-and-fire-functions",
  "scripts": {
    "build": "node -e \"require('fs').copyFileSync('../shared/seed-settings.json', 'src/seed-settings.json')\" && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "test": "tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project faithandfire-b0455 \"tsx --test tests/rules/firestore-rules.test.ts\"",
    "test:storage": "firebase emulators:exec --only storage --project faithandfire-b0455 \"tsx --test tests/rules/storage-rules.test.ts\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.0",
    "firebase": "^11.10.0",
    "firebase-tools": "^13.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "private": true
}

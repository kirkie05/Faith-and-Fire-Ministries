rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // REUSABLE SECURITY PRIMITIVES & HELPERS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return request.auth.token.role != null ? request.auth.token.role : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isVerified() && getRole() == 'SuperAdmin';
    }

    function isAdmin() {
      return isVerified() && (getRole() == 'SuperAdmin' || getRole() == 'Admin');
    }

    function isPastor() {
      return isVerified() && (getRole() == 'SuperAdmin' || getRole() == 'Pastor');
    }

    function isStaff() {
      return isVerified() && (
        getRole() == 'SuperAdmin' ||
        getRole() == 'Admin' ||
        getRole() == 'Pastor' ||
        getRole() == 'Minister' ||
        getRole() == 'DepartmentLeader'
      );
    }

    function isMember() {
      return isVerified() && (
        getRole() == 'SuperAdmin' ||
        getRole() == 'Admin' ||
        getRole() == 'Pastor' ||
        getRole() == 'Minister' ||
        getRole() == 'DepartmentLeader' ||
        getRole() == 'Volunteer' ||
        getRole() == 'Member'
      );
    }

    // ==========================================
    // VALIDATION HELPERS
    // ==========================================
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status', 'ownerId']) &&
             data.uid is string && isValidId(data.uid) &&
             data.email is string && data.email.size() <= 150 &&
             data.role is string && data.role in ['SuperAdmin', 'Admin', 'Pastor', 'Minister', 'DepartmentLeader', 'Volunteer', 'Member', 'Guest'] &&
             data.status is string && data.status in ['active', 'suspended', 'archived'] &&
             data.ownerId == data.uid;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['firstName', 'lastName', 'email', 'ownerId']) &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.ownerId is string && isValidId(data.ownerId);
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['memberId', 'serviceName', 'timestamp', 'date', 'ownerId']) &&
             data.memberId is string && isValidId(data.memberId) &&
             data.serviceName is string && data.serviceName.size() <= 200 &&
             data.ownerId is string && isValidId(data.ownerId);
    }

    function isValidSermon(data) {
      return data.keys().hasAll(['title', 'youtubeUrl', 'ownerId']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.youtubeUrl is string && data.youtubeUrl.size() <= 500 &&
             data.ownerId is string && isValidId(data.ownerId);
    }

    function isValidDevotional(data) {
      return data.keys().hasAll(['title', 'content', 'date', 'ownerId']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.ownerId is string && isValidId(data.ownerId);
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'content', 'date', 'ownerId']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.ownerId is string && isValidId(data.ownerId);
    }

    function isValidPrayerRequest(data) {
      return data.keys().hasAll(['requestText', 'ownerId']) &&
             data.requestText is string && data.requestText.size() > 0 && data.requestText.size() <= 2000 &&
             data.ownerId is string && isValidId(data.ownerId) &&
             data.ownerId == request.auth.uid;
    }

    function isValidDonation(data) {
      return data.keys().hasAll(['amount', 'fund', 'email']) &&
             data.amount is number && data.amount > 0 &&
             data.fund is string && data.fund.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.message is string && data.message.size() <= 2000;
    }

    // ==========================================
    // COLLECTION MATCH RULES
    // ==========================================

    // 1. Users Collection (RBAC & Profiles)
    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == 'Member';
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Members Collection (Church Register & PII)
    match /members/{memberId} {
      allow get: if isStaff() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isStaff();
      allow create: if isStaff() || (isVerified() && isValidMember(request.resource.data) && request.resource.data.ownerId == request.auth.uid);
      allow update: if isStaff() || (isVerified() && resource.data.ownerId == request.auth.uid && isValidMember(request.resource.data));
      allow delete: if isAdmin();
    }

    // 3. Attendance Collection
    match /attendance/{attendanceId} {
      allow get, list: if isStaff();
      allow create: if isVerified() && isValidAttendance(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 4. Sermons Collection (Public Catalog)
    match /sermons/{sermonId} {
      allow read: if true;
      allow create, update, delete: if isStaff() && isValidSermon(request.resource.data);
    }

    // 5. Devotionals Collection (Public Reading)
    match /devotionals/{devotionalId} {
      allow read: if true;
      allow create, update, delete: if isStaff() && isValidDevotional(request.resource.data);
    }

    // 6. YouTube Channels Configuration
    match /youtubeChannels/{channelId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 7. Banking Details (Public View / Staff Manage)
    match /bankingDetails/{detailsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Donations Collection
    match /donations/{donationId} {
      allow create: if isValidDonation(request.resource.data);
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // 9. Payment Transactions (Server-Side Only)
    match /transactions/{transactionId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.userUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // 10. Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isStaff() && isValidAnnouncement(request.resource.data);
    }

    // 11. Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // 12. Ministries Collection
    match /ministries/{ministryId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // 13. Prayer Requests Collection
    match /prayerRequests/{requestId} {
      allow create: if request.resource.data.requestText is string &&
        request.resource.data.requestText.size() > 0 && request.resource.data.requestText.size() <= 2000;
      allow get, list: if isStaff() || (
        isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.isPrivate == false
        )
      );
      allow update: if isStaff() || (isOwner(resource.data.ownerId) && isValidPrayerRequest(request.resource.data));
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /memberApplications/{applicationId} {
      allow create: if request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        request.resource.data.email is string;
      allow get, list, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 14. Testimonies Collection
    match /testimonies/{testimonyId} {
      allow read: if true;
      allow create: if isVerified();
      allow update, delete: if isStaff();
    }

    // 15. Messages & Contact Forms
    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
      allow get, list, update, delete: if isStaff();
    }

    match /connectSubmissions/{submissionId} {
      allow create: if true;
      allow get, list, update, delete: if isStaff();
    }

    // Public first-time visitor cards are intentionally narrow: the backend
    // enriches them with follow-up records and notification metadata.
    match /visitors/{visitorId} {
      allow create: if request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200 &&
        request.resource.data.details is string && request.resource.data.details.size() <= 4000;
      allow get, list, update: if isStaff();
      allow delete: if false;
    }

    match /followUps/{followUpId} {
      allow get, list, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /followUpTasks/{taskId} { allow get, list, update: if isStaff(); allow create, delete: if false; }

    match /departments/{recordId} { allow read, write: if isStaff(); }
    match /smallGroups/{recordId} { allow read, write: if isStaff(); }
    match /volunteerApplications/{recordId} { allow read, write: if isStaff(); }
    match /membershipClasses/{recordId} { allow read, write: if isStaff(); }
    match /discipleship/{recordId} { allow read, write: if isStaff() || (isSignedIn() && resource.data.ownerId == request.auth.uid); }
    match /careCases/{recordId} { allow read, write: if isPastor(); }
    match /pastoralVisits/{recordId} { allow read, write: if isPastor(); }
    match /tasks/{recordId} { allow read, write: if isStaff(); }
    match /campaigns/{recordId} { allow read, write: if isAdmin(); }
    match /blogPosts/{recordId} { allow read: if resource.data.status == 'Published' || isStaff(); allow write: if isStaff(); }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.name is string &&
        request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 150 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow get, list, update: if isStaff();
      allow delete: if isAdmin();
    }

    // 16. Notifications Collection
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create, delete: if isStaff();
    }

    // 17. Church Global Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 18. Immutable Audit Logs
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isVerified();
      allow update, delete: if false;
    }
  }
}

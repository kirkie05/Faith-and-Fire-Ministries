# Environment Variables Template
# Copy to .env and fill in locally. .env is gitignored — never commit real keys.

# PUBLIC, BROWSER-SAFE API KEY (YouTube Data API v3).
# Used client-side in PublicScreens to fetch the church's YouTube feed.
# Because it ships in the public JS bundle, it CANNOT be a server secret.
# In Google Cloud Console, restrict it to:
#   1. API: "YouTube Data API v3" ONLY (no other APIs)
#   2. HTTP referrers: https://faithandfireministries.co.za/* and
#      http://localhost:3000/* (dev only)
# If you cannot apply these restrictions, stop shipping the key in the
# client and proxy the feed through a server-side callable instead.
VITE_YOUTUBE_API_KEY=

# Optional: Google Maps Places API key for the admin address autocomplete
# (browser-safe, restrict by API + referrer the same way).
# VITE_GOOGLE_MAPS_API_KEY=

# Server-side key for Google Reviews sync (functions runtime env only,
# NEVER a VITE_* variable).
# GOOGLE_MAPS_PLATFORM_KEY=
